FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      porousProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

porousModel     vanGenuchten;

// Van Genuchten coefficients
coefficients
{
    SeMin           1.0e-4;
    Smax            1.0;
    Sr              0.046;
    nIm             6.23;
    lIm             0.5;
    pc0Im           555.56;
    nDr             10.57;
    lDr             0.2;
    pc0Dr           984.90;
}

