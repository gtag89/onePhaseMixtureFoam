FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=64;scalar=64";
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    frontAndBack
    {
        type            empty;
    }
    rightAndLeft
    {
        type            empty;
    }
    top
    {
        type            fixedValue;
        value           uniform (0 0 -8.84e-04);
    }
    bottom
    {
        type            zeroGradient;
    }
}


