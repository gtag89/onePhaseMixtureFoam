FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "(Sw|divU)"
    {
        solver             PBiCGStab;
        preconditioner     DIC;
        tolerance          1.0e-8;
        relTol             0.01;
        minIter            1;
    }

    "(Sw|divU)Final"
    {
        $Sw;
        relTol             0.0;
    }

    "(U|rho)"
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-8;
        relTol          0.01;
        nPreSweeps      0;
        nPostSweeps     2;
        nFinestSweeps   2;
        cacheAgglomeration  true;
        agglomerator    faceAreaPair;
        nCellsInCoarsestLevel 200;
        mergeLevels     1;
    }

    "(U|rho)Final"
    {
        $U;
        relTol          0;
    }
}

PIMPLE
{
    momentumPredictor no;
    nOuterCorrectors  10;
    nCorrectors       4;
    nNonOrthogonalCorrectors 0;

    residualControl
    {
        U
        {
                tolerance  1e-6;
                relTol      0;
        }
        Sw
        {
                tolerance  1e-6;
                relTol      0;
        }
    }
}

relaxationFactors
{
    fields
    {
        Sw              0.5;
        U               0.7;
    }
    equations
    {
        Sw              0.7;
        U               0.9;
    }
}

